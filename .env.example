# APNA STORE — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env or pass values using --dart-define flags.
# DO NOT COMMIT REAL PRODUCTION SECRETS OR SERVICE-ROLE KEYS TO VERSION CONTROL.

# Supabase Project Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Application Environment Mode (development | staging | production)
APP_ENV=development

# Usage Examples with Flutter CLI:
# flutter run --dart-define=SUPABASE_URL=https://xyz.supabase.co --dart-define=SUPABASE_ANON_KEY=your-key
# flutter build web --dart-define=SUPABASE_URL=https://xyz.supabase.co --dart-define=SUPABASE_ANON_KEY=your-key --dart-define=APP_ENV=production
# flutter build apk --release --dart-define=SUPABASE_URL=https://xyz.supabase.co --dart-define=SUPABASE_ANON_KEY=your-key --dart-define=APP_ENV=production
